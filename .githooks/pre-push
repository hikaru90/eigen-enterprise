#!/usr/bin/env bash
# Pre-push: every pushed commit must be covered by a green local CI gate.
#
# Covered = the commit the gate last passed on (stamped by scripts/ci-gate.sh in
# <git common dir>/ee-gate/passed) or one of its ancestors. Uncovered → run the
# gate here (it stamps HEAD). Note: git already holds the remote connection while
# this runs; a long gate can let it idle out (push exit 141). The stamp makes the
# retry instant — or push with `npm run push -- …`, which gates first.
set -euo pipefail

zero=0000000000000000000000000000000000000000
stamp_file="$(git rev-parse --git-common-dir)/ee-gate/passed"
pushed=()
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] || pushed+=("$local_sha") # zero = deleting a remote ref
done

uncovered() {
  local gated sha
  gated="$(cat "$stamp_file" 2>/dev/null || true)"
  for sha in "${pushed[@]+"${pushed[@]}"}"; do
    if [ -z "$gated" ] || ! git merge-base --is-ancestor "$sha" "$gated" 2>/dev/null; then
      echo "$sha"
    fi
  done
}

if [ -z "$(uncovered)" ]; then
  echo "pre-push: local CI gate already green for $(cut -c1-12 "$stamp_file" 2>/dev/null || echo 'nothing to push')"
  exit 0
fi

echo "pre-push: running local CI gate (scripts/ci-gate.sh) …"
echo "pre-push: if the push then fails with a dropped connection (exit 141), run it again — the green gate is stamped. Next time: npm run push -- <args>."
"$(git rev-parse --show-toplevel)/scripts/ci-gate.sh" </dev/null

left="$(uncovered)"
if [ -n "$left" ]; then
  echo "pre-push: the gate ran on HEAD $(git rev-parse --short HEAD), which doesn't contain these pushed commits:" >&2
  echo "$left" >&2
  echo "pre-push: check them out and push from there." >&2
  exit 1
fi
